# Copy to .streamlit/secrets.toml for local development. Do not commit that file.
# Use the Supabase Session Pooler hostname/port shown under Connect, with the
# dedicated dashboard_reader role created by supabase_dashboard_reader.sql.
[database]
url = "postgresql://dashboard_reader:REPLACE_WITH_STRONG_PASSWORD@YOUR_PROJECT_POOLER_HOST:5432/postgres?sslmode=require"
